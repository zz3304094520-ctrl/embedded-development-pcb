[Unit]
Description=Huitian RS485 soil and weather sensor agent
After=network-online.target
Wants=network-online.target
Conflicts=fieldmate-edge.service

[Service]
Type=simple
User=qiongyi
SupplementaryGroups=dialout
WorkingDirectory=/home/qiongyi/fieldmate-edge
ExecStart=/home/qiongyi/fieldmate-edge/.venv/bin/python -m sensor_gateway --config /home/qiongyi/fieldmate-edge/sensor_gateway/config.json
Restart=always
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=10
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
