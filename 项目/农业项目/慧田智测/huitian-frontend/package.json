    "gsap": "^3.15.0",
    "vue": "^3.5.38"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "typescript": "^6.0.3",
    "vite": "^8.1.0",
    "vue-tsc": "^3.1.5"
  }
}
